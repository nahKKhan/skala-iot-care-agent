# 이 파일을 .env로 복사한 후 실제 값을 입력하세요. .env는 Git에서 제외됩니다.
LLM_BACKEND=ollama
OPENAI_API_KEY=sk-...
OPENAI_QUALITY_MODEL=gpt-4o

# 로컬 Ollama 사용 시: bash sh/run_iot_agent.sh ollama
OLLAMA_QUALITY_MODEL=qwen3.5:2b

# 기본 점검에는 LangSmith 키가 필요하지 않습니다.
LANGCHAIN_TRACING_V2=false
LANGSMITH_TRACING=false
# LANGCHAIN_API_KEY=본인의_LangSmith_키
# LANGCHAIN_PROJECT=iot-care-agent
